{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account information and system settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Uniquely identifies this user synced with Auth UID"
        },
        "email": {
          "type": "string",
          "description": "The user's registered email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of account registration"
        }
      },
      "required": ["userId", "email"]
    },
    "CarProfile": {
      "title": "CarProfile",
      "description": "Car technical parameters and odometer values",
      "type": "object",
      "properties": {
        "makeModel": { "type": "string" },
        "fuelType": { "type": "string" },
        "year": { "type": "integer" },
        "currentKm": { "type": "integer" },
        "monthlyKm": { "type": "integer" },
        "registrationDate": { "type": "string" }
      },
      "required": ["makeModel", "fuelType", "year", "currentKm", "monthlyKm"]
    },
    "MaintenanceTask": {
      "title": "MaintenanceTask",
      "description": "Recommended intervals or manual user maintenance entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tarea": { "type": "string" },
        "cada_km": { "type": "integer" },
        "cada_meses": { "type": "integer" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["id", "tarea", "cada_km", "cada_meses"]
    },
    "TaskTracking": {
      "title": "TaskTracking",
      "description": "Logging of completion data for maintenance tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The corresponding task identifier" },
        "lastCompletedKm": { "type": "integer" },
        "lastCompletedDate": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles database"
    },
    "/users/{userId}/car/profile": {
      "schema": "CarProfile",
      "description": "The user's car technical specifications"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "MaintenanceTask",
      "description": "Maintenance tasks for the user's car"
    },
    "/users/{userId}/tracking/{trackingId}": {
      "schema": "TaskTracking",
      "description": "Completed services tracking list for the user's car"
    }
  }
}
